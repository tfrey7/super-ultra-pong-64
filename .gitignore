# This project has no build step and no dependencies on purpose.
# Nothing here should ever appear; the entries are guards, not needs.
node_modules/
package-lock.json
npm-debug.log*

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
Desktop.ini
.DS_Store

# The playtest harness rewrites these on every run, so they are output, not
# source. The reference frame a reader opens lives in docs/shots/bootstrap/.
docs/shots/playtest/

# The fleet's worker launcher reserves a port by writing .state/portlocks/
# into this checkout. It is a runtime claim that expires by itself, not source.
.state/

# Scratch
tmp/
*.tmp
*.log
